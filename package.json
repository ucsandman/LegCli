{
  "name": "baton-agents",
  "version": "0.6.1",
  "description": "Claude Code and Codex usage limit monitor with an automatic handoff. Type baton claude|codex|agy and get the same interactive agent with a board alongside, usage tracking per agent and account, a live context handoff bundle, and at the limit the next agent continuing in the same terminal. $79 once, 30-day money-back guarantee.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://baton-agents.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/ucsandman/baton.git"
  },
  "bugs": {
    "url": "https://baton-agents.vercel.app/support",
    "email": "baton@practicalsystems.io"
  },
  "keywords": [
    "claude-usage-limit",
    "claude-code-usage-limit",
    "codex-usage-limit",
    "usage-monitor",
    "usage-limits",
    "claude-code",
    "codex",
    "coding-agents",
    "agent-harness",
    "handoff",
    "kanban",
    "worktree",
    "local-first"
  ],
  "author": "Wes Sander",
  "bin": {
    "baton": "bin/baton.mjs"
  },
  "files": [
    "bin",
    "src",
    "scripts",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "docs",
    "fixtures/limits",
    "fixtures/live",
    "fixtures/verified.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env bin/baton.mjs up",
    "test": "node --test --test-concurrency=1 && node scripts/privacy-check.mjs && node scripts/check-claims.mjs",
    "lint": "eslint .",
    "privacy": "node scripts/privacy-check.mjs",
    "claims": "node scripts/check-claims.mjs",
    "claims:drift": "node scripts/check-claims.mjs --strict",
    "docs": "node scripts/build-docs-site.mjs",
    "dev": "node --env-file-if-exists=.env bin/baton.mjs up --no-open",
    "stop": "node bin/baton.mjs down"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "globals": "^16",
    "marked": "^18.0.13"
  }
}
