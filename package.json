{
  "name": "agent-baton",
  "version": "0.2.0",
  "description": "baton claude|codex|agy: your interactive coding agent with a board alongside, usage-limit tracking, a live context handoff bundle, and a hand-off to the next agent in the same terminal when the limit hits.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ucsandman/baton.git"
  },
  "homepage": "https://github.com/ucsandman/baton#readme",
  "bugs": {
    "url": "https://github.com/ucsandman/baton/issues"
  },
  "keywords": [
    "kanban",
    "coding-agents",
    "claude-code",
    "codex",
    "agent-harness",
    "usage-limits",
    "antigravity",
    "handoff",
    "worktree",
    "local-first"
  ],
  "author": "Wes Sander",
  "bin": {
    "baton": "bin/baton.mjs"
  },
  "files": [
    "bin",
    "src",
    "scripts",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env bin/baton.mjs up",
    "test": "node --test && node scripts/privacy-check.mjs",
    "lint": "eslint .",
    "privacy": "node scripts/privacy-check.mjs",
    "dev": "node --env-file-if-exists=.env bin/baton.mjs up --no-open",
    "stop": "node bin/baton.mjs down"
  },
  "devDependencies": {
    "eslint": "^9",
    "@eslint/js": "^9",
    "globals": "^16"
  }
}
