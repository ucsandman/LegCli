{
  "name": "agent-baton",
  "version": "0.1.0",
  "description": "Local-first kanban board and meta-harness for coding-agent CLIs: fallback chains, usage-limit handoff bundles, one worktree per card.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "baton": "bin/baton.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env bin/baton.mjs up",
    "test": "node --test && node scripts/privacy-check.mjs",
    "lint": "eslint .",
    "privacy": "node scripts/privacy-check.mjs",
    "dev": "node --env-file-if-exists=.env bin/baton.mjs up --no-open",
    "stop": "node bin/baton.mjs down"
  },
  "devDependencies": {
    "eslint": "^9",
    "@eslint/js": "^9",
    "globals": "^16"
  }
}
