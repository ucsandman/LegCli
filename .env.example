# Baton reads this file only through `node --env-file-if-exists=.env` in npm scripts.
# Every value is optional. Never commit a real .env.
BATON_HOME=
BATON_PORT=4747
BATON_BIND=127.0.0.1
BATON_TOKEN=
BATON_MAX_CONCURRENT=2
BATON_MAX_LAND_ATTEMPTS=3
# Optional syncs (off unless set to 1)
BATON_SYNC_WORKBOARD=0
BATON_SYNC_DASHCLAW=0
DASHCLAW_URL=
DASHCLAW_API_KEY=

# License signing (seller only; never committed). The public half is embedded in src/license.mjs.
BATON_LICENSE_PRIVATE_KEY=
# Site origin the CLI points buyers at (default https://baton-agents.vercel.app)
BATON_SITE=

# Checkout and key delivery (site/api); creds resolve fills these from the vault
STRIPE_SECRET_KEY=
STRIPE_TEST_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_LIVE_WEBHOOK_SECRET=
RESEND_API_KEY=
BATON_SITE_ORIGIN=
BATON_MAIL_FROM=
BATON_MAIL_REPLY_TO=
# External npm publishing automation only; repository scripts do not read this.
NPM_TOKEN=

# Trust records: Baton writes the folder-trust answer each agent CLI asks for on
# its first run in a repo, so a handoff at 3am does not stall on a prompt.
# Set to "never" to leave those config files alone and answer the prompts yourself.
BATON_TRUST=auto
