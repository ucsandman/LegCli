# Leg reads this file only through `node --env-file-if-exists=.env` in npm scripts.
# Every value is optional. Never commit a real .env.
# BATON_* names still work as a fallback if a LEG_* value is unset.
LEG_HOME=
LEG_PORT=4747
LEG_BIND=127.0.0.1
LEG_TOKEN=
# TLS for a shared board (leg share). Leg issues no certificate: point these at
# a pair you already have, e.g. tailscale cert <machine>.<tailnet>.ts.net.
# Both or neither; a half-configured or unreadable pair stops the board (exit 3).
LEG_TLS_CERT=
LEG_TLS_KEY=
LEG_MAX_CONCURRENT=2
LEG_MAX_LAND_ATTEMPTS=3
# Optional syncs (off unless set to 1)
LEG_SYNC_WORKBOARD=0
LEG_SYNC_DASHCLAW=0
DASHCLAW_URL=
DASHCLAW_API_KEY=

# License signing (seller only; never committed). The public half is embedded in src/license.mjs.
LEG_LICENSE_PRIVATE_KEY=
# Site origin the CLI points buyers at (default https://legcli.com)
LEG_SITE=

# Checkout and key delivery (site/api); creds resolve fills these from the vault
STRIPE_SECRET_KEY=
STRIPE_TEST_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_LIVE_WEBHOOK_SECRET=
RESEND_API_KEY=
LEG_SITE_ORIGIN=
LEG_MAIL_FROM=
LEG_MAIL_REPLY_TO=
# External npm publishing automation only; repository scripts do not read this.
NPM_TOKEN=

# Keep native client approval behavior. Set to 1 only to opt into permission bypass.
LEG_AUTO_APPROVE=0
# Trust writes are a separate opt-in: auto records folder trust in client configs
# and approves external CLAUDE.md imports. never leaves those prompts to the client.
# Disabling writes does not revoke trust already recorded.
LEG_TRUST=never
